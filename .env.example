# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_USER=contract
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contract

# --- Gemini (shared key — operator pays) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Models (registry defaults; bind to live 3.x tier) ---
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_ACCURATE=gemini-pro-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Full-text (BM25) backend ---
# pg_search = ParadeDB (production/Docker; true BM25). tsvector = Postgres built-in
# (local runs on vanilla Postgres without ParadeDB; lower quality, no extra extension).
FTS_BACKEND=pg_search

# --- File storage (local FS) ---
FILE_STORAGE_DIR=/data/files

# --- Reranker (self-hosted cross-encoder service) ---
RERANKER_URL=http://reranker:8080

# --- Cost guardrails ---
MAX_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS=1500
DAILY_SPEND_LIMIT_USD=50
PER_USER_DAILY_TOKEN_LIMIT=2000000
